[Unit]
Description=Wayland scroll forwarder for GeForce NOW
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%h/.local/bin/wayland-scroll-forwarder --allow-unfocused --wait-for-device --device /dev/input/wayland-scroll-forwarder-mouse GeForceNOW
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
