# Generated by install-persistent.sh. Grants the active seat user access only to
# the selected mouse interface and gives it a stable name across reconnects.
ACTION=="add", SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_MOUSE}=="1", ATTRS{name}=="@DEVICE_NAME@", TAG+="uaccess", SYMLINK+="input/wayland-scroll-forwarder-mouse"
